{
  "name": "@naai-erp/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "naai-erp": "dist/main.js"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "migrate:workbook-expenses": "tsx src/migrate-workbook-expenses.ts",
    "backfill:expense-categories": "tsx src/backfill-expense-categories.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@naai-erp/contracts": "workspace:*",
    "exceljs": "4.4.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

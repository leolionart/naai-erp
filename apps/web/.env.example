NEXT_PUBLIC_NAAI_ERP_API_URL=http://localhost:3001
NEXT_PUBLIC_NAAI_ERP_ORGANIZATION=naai
# Local development only. Put the real value in ignored apps/web/.env.local.
NEXT_PUBLIC_NAAI_ERP_DEV_TOKEN=change-me-local-only

# Optional read-only production-data mode for local UI development.
# NEXT_PUBLIC_API_URL=http://localhost:3000/dev-api
# NEXT_PUBLIC_ORGANIZATION_ID=naai
# NEXT_PUBLIC_FORCE_DEFAULT_API_CONNECTION=1
# NAAI_ERP_DEV_UPSTREAM_BASE_URL=https://erp.naai.studio
# NAAI_ERP_DEV_UPSTREAM_ORGANIZATION=naai
# NAAI_ERP_DEV_UPSTREAM_TOKEN=<server-only; never use a NEXT_PUBLIC_ prefix>

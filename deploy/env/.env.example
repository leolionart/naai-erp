# Copy to a deployment-only file such as .env.production. Never commit real secrets.
POSTGRES_DB=naai_erp
POSTGRES_USER=naai_erp
POSTGRES_PASSWORD=replace-with-a-strong-random-password

APP_BASE_URL=https://erp.example.com
# Keep this stable across releases. Rotating it signs out all active web sessions.
SESSION_SECRET=replace-with-at-least-32-random-characters
WEBHOOK_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Server-only web login. The API token must match an active api_credentials
# record for this organization; never expose these values as NEXT_PUBLIC_*.
NAAI_ERP_LOGIN_USERNAME=owner
NAAI_ERP_LOGIN_PASSWORD=replace-with-a-strong-random-password
NAAI_ERP_LOGIN_ORGANIZATION=naai
NAAI_ERP_LOGIN_API_TOKEN=replace-with-the-provisioned-owner-api-token
# Bootstrap the login organization as a one-owner business only when its workflow policy is missing.
NAAI_ERP_SOLOPRENEUR=true

# release-main.yml publishes `main` and immutable `sha-<12-char-commit>` tags.
IMAGE_TAG=sha-000000000000

API_PORT=3001
WEB_PORT=3000

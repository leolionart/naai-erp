{
  "openapi": "3.1.0",
  "info": {
    "title": "NAAI ERP API",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost:3001"
    }
  ],
  "x-naai-resources": [
    "organizations",
    "fiscal-years",
    "fiscal-periods",
    "exchange-rates",
    "accounts",
    "accounting-workflow-policy",
    "statutory-mappings",
    "tax-code-versions",
    "dimensions",
    "dimension-requirements",
    "default-mappings",
    "parties",
    "projects",
    "contracts",
    "milestones",
    "posting-rule-versions"
  ],
  "x-naai-workflows": [
    "journals/approve",
    "journals/post",
    "journals/reverse",
    "journals/repost",
    "fiscal-periods/close",
    "fiscal-periods/reopen",
    "posting-rules/evaluate",
    "reports/trial-balance",
    "reports/general-ledger",
    "opening-balances/dry-run",
    "opening-balances/create",
    "commercial-documents/create",
    "commercial-documents/capture",
    "commercial-documents/validate",
    "commercial-documents/verify",
    "commercial-documents/approve",
    "commercial-documents/issue",
    "commercial-documents/post",
    "commercial-documents/cancel",
    "expenses/create",
    "expenses/submit",
    "expenses/mark-evidence-pending",
    "expenses/review",
    "expenses/approve",
    "expenses/reject",
    "expenses/post",
    "evidence/upload",
    "evidence/review",
    "evidence/download-url",
    "inbound-events/receive",
    "inbound-events/replay",
    "banking/accounts/create",
    "banking/accounts/deactivate",
    "banking/imports/dry-run",
    "banking/imports/create",
    "banking/transactions/ignore",
    "banking/transactions/mark-needs-review",
    "banking/transactions/candidates",
    "banking/transactions/suggest",
    "banking/transactions/match",
    "banking/transactions/reconcile",
    "banking/transactions/unreconcile"
  ],
  "paths": {
    "/api/v1/organizations/{organizationId}/master-data/resources": {
      "get": {
        "summary": "List available master-data resources"
      }
    },
    "/api/v1/organizations/{organizationId}/master-data/{resource}": {
      "get": {
        "summary": "List organization-scoped resources"
      },
      "post": {
        "summary": "Create an idempotent resource"
      }
    },
    "/api/v1/organizations/{organizationId}/master-data/{resource}/{key}": {
      "get": {
        "summary": "Get by opaque resource key"
      },
      "patch": {
        "summary": "Update draft or mutable master data with optimistic version"
      }
    },
    "/api/v1/organizations/{organizationId}/master-data/{resource}/{key}/deactivate": {
      "post": {
        "summary": "Deactivate a resource where supported"
      }
    },
    "/api/v1/organizations/{organizationId}/master-data/{resource}/import/dry-run": {
      "post": {
        "summary": "Validate bulk rows without writes"
      }
    },
    "/api/v1/organizations/{organizationId}/master-data/{resource}/export": {
      "get": {
        "summary": "Export deterministically ordered JSON"
      }
    },
    "/api/v1/organizations/{organizationId}/journals": {
      "get": {
        "summary": "List organization-scoped journals with exact string amounts"
      },
      "post": {
        "summary": "Create an idempotent draft journal"
      }
    },
    "/api/v1/organizations/{organizationId}/journals/{journalId}": {
      "get": {
        "summary": "Read a journal and its ordered lines"
      }
    },
    "/api/v1/organizations/{organizationId}/journals/{journalId}/post": {
      "post": {
        "summary": "Atomically post a balanced journal with audit and outbox effects"
      }
    },
    "/api/v1/organizations/{organizationId}/journals/{journalId}/approve": {
      "post": {
        "summary": "Approve a draft journal with maker-checker and explicit reason"
      }
    },
    "/api/v1/organizations/{organizationId}/journals/{journalId}/reverse": {
      "post": {
        "summary": "Create and post a linked inverse journal without mutating ledger history"
      }
    },
    "/api/v1/organizations/{organizationId}/journals/{journalId}/repost": {
      "post": {
        "summary": "Create a corrected replacement draft linked to a reversed journal"
      }
    },
    "/api/v1/organizations/{organizationId}/posting-rules/evaluate": {
      "post": {
        "summary": "Evaluate effective posting rules into an exact balanced draft without posting"
      }
    },
    "/api/v1/organizations/{organizationId}/fiscal-periods/close": {
      "post": {
        "summary": "Move an open period to soft lock or a soft-locked period to hard lock"
      }
    },
    "/api/v1/organizations/{organizationId}/fiscal-periods/reopen": {
      "post": {
        "summary": "Privileged audited stepwise reopen of a locked fiscal period"
      }
    },
    "/api/v1/organizations/{organizationId}/reports/trial-balance": {
      "get": {
        "summary": "Read an exact Trial Balance derived only from posted and reversed ledger history"
      }
    },
    "/api/v1/organizations/{organizationId}/reports/general-ledger": {
      "get": {
        "summary": "Read ordered journal-line drill-down with exact running balances"
      }
    },
    "/api/v1/organizations/{organizationId}/opening-balances/dry-run": {
      "post": {
        "summary": "Validate opening balance control totals and AR/AP details without persistence"
      }
    },
    "/api/v1/organizations/{organizationId}/opening-balances": {
      "get": {
        "summary": "List organization-scoped opening-balance imports and linked journal state"
      },
      "post": {
        "summary": "Create an idempotent opening-balance draft journal for normal approval and posting"
      }
    },
    "/api/v1/organizations/{organizationId}/opening-balances/{importId}": {
      "get": {
        "summary": "Read opening-balance controls, ordered lines and linked approval/posting state"
      }
    },
    "/api/v1/organizations/{organizationId}/commercial-documents": {
      "get": {
        "summary": "List organization-scoped sales invoices, purchase invoices and credit notes"
      },
      "post": {
        "summary": "Create an idempotent exact-amount commercial document draft with allocations"
      }
    },
    "/api/v1/organizations/{organizationId}/commercial-documents/{documentId}": {
      "get": {
        "summary": "Read a document, lines, allocations, journal link and permitted next actions"
      }
    },
    "/api/v1/organizations/{organizationId}/commercial-documents/{documentId}/{action}": {
      "post": {
        "summary": "Run a controlled lifecycle command; issue/post atomically creates the balanced linked journal"
      }
    },
    "/api/v1/organizations/{organizationId}/expenses": {
      "get": {
        "summary": "List organization-scoped expenses with independent management CIT and VAT states"
      },
      "post": {
        "summary": "Create an idempotent expense draft including non-invoice and reimbursement classes"
      }
    },
    "/api/v1/organizations/{organizationId}/expenses/{expenseId}": {
      "get": {
        "summary": "Read expense lines allocations review states evidence checklist and journal link"
      }
    },
    "/api/v1/organizations/{organizationId}/expenses/{expenseId}/review": {
      "post": {
        "summary": "Review management CIT or VAT independently with eligible amount reason and reference"
      }
    },
    "/api/v1/organizations/{organizationId}/expenses/{expenseId}/{action}": {
      "post": { "summary": "Submit request evidence approve reject or atomically post an expense" }
    },
    "/api/v1/organizations/{organizationId}/evidence": {
      "get": { "summary": "List organization-scoped evidence metadata and current versions" },
      "post": {
        "summary": "Upload allowlisted evidence bytes with server-computed SHA-256 and duplicate warnings"
      }
    },
    "/api/v1/organizations/{organizationId}/evidence/{evidenceId}": {
      "get": { "summary": "Read immutable version history without exposing storage credentials" }
    },
    "/api/v1/organizations/{organizationId}/evidence/{evidenceId}/review": {
      "post": { "summary": "Accept reject or request review with actor reason timestamp and audit" }
    },
    "/api/v1/organizations/{organizationId}/evidence/{evidenceId}/download-url": {
      "post": {
        "summary": "Issue an audited organization-authorized signed URL with a maximum 300 second TTL"
      }
    },
    "/api/v1/inbound/{sourcePublicId}/events": {
      "post": {
        "summary": "Receive an exact-raw-body HMAC signed versioned event with timestamp and idempotency protection",
        "security": []
      }
    },
    "/api/v1/organizations/{organizationId}/inbound-events": {
      "get": {
        "summary": "List organization-scoped inbox quarantine retry and dead-letter records"
      }
    },
    "/api/v1/organizations/{organizationId}/inbound-events/{messageId}": {
      "get": {
        "summary": "Read inbound metadata immutable raw payload hash and append-only attempt history"
      }
    },
    "/api/v1/organizations/{organizationId}/inbound-events/{messageId}/replay": {
      "post": {
        "summary": "Replay an authenticated quarantined or dead-letter event with privileged reason and audit"
      }
    },
    "/api/v1/organizations/{organizationId}/banking/accounts": {
      "get": {
        "summary": "List organization-owned bank and cash accounts with cursor pagination"
      },
      "post": {
        "summary": "Create an idempotent organization-owned bank or cash account linked to its ledger account"
      }
    },
    "/api/v1/organizations/{organizationId}/banking/accounts/{accountId}": {
      "get": {
        "summary": "Read one organization-owned bank or cash account"
      },
      "patch": {
        "summary": "Update mutable bank account metadata with optimistic resource version"
      }
    },
    "/api/v1/organizations/{organizationId}/banking/accounts/{accountId}/deactivate": {
      "post": {
        "summary": "Deactivate a bank or cash account without removing its statement history"
      }
    },
    "/api/v1/organizations/{organizationId}/banking/imports": {
      "get": {
        "summary": "List versioned organization-scoped bank statement imports and row control totals"
      },
      "post": {
        "summary": "Idempotently ingest versioned CSV rows with immutable raw payloads and duplicate prevention"
      }
    },
    "/api/v1/organizations/{organizationId}/banking/imports/dry-run": {
      "post": {
        "summary": "Validate a versioned CSV adapter and return row-level new duplicate and invalid dispositions without writes"
      }
    },
    "/api/v1/organizations/{organizationId}/banking/imports/{importId}": {
      "get": {
        "summary": "Read one statement import with row-level results and immutable raw payload hash"
      }
    },
    "/api/v1/organizations/{organizationId}/banking/transactions": {
      "get": {
        "summary": "List imported bank transactions with exact string amounts state and latest normalization version"
      }
    },
    "/api/v1/organizations/{organizationId}/banking/transactions/{transactionId}": {
      "get": {
        "summary": "Read immutable raw metadata and append-only normalized representation history"
      }
    },
    "/api/v1/organizations/{organizationId}/banking/transactions/{transactionId}/ignore": {
      "post": {
        "summary": "Move an imported or suggested transaction to the audited ignored branch"
      }
    },
    "/api/v1/organizations/{organizationId}/banking/transactions/{transactionId}/mark-needs-review": {
      "post": {
        "summary": "Move a transaction to the audited needs-review branch without matching or reconciling it"
      }
    },
    "/api/v1/organizations/{organizationId}/banking/transactions/{transactionId}/candidates": {
      "get": {
        "summary": "Read explainable integer-bps reconciliation candidates and the versioned auto-match decision"
      }
    },
    "/api/v1/organizations/{organizationId}/banking/transactions/{transactionId}/suggest": {
      "post": {
        "summary": "Generate and persist a versioned candidate score snapshot without creating accounting effects"
      }
    },
    "/api/v1/organizations/{organizationId}/banking/transactions/{transactionId}/match": {
      "post": {
        "summary": "Create an idempotent append-only match attempt with exact partial allocations and explicit fee FX or suspense adjustments"
      }
    },
    "/api/v1/organizations/{organizationId}/banking/transactions/{transactionId}/reconcile": {
      "post": {
        "summary": "Atomically post or link the balanced payment journal lock allocations and expose source evidence drill-down"
      }
    },
    "/api/v1/organizations/{organizationId}/banking/transactions/{transactionId}/unreconcile": {
      "post": {
        "summary": "Privileged audited unreconcile with immutable prior attempt and required payment-journal reversal"
      }
    },
    "/api/v1/organizations/{organizationId}/banking/reconciliations": {
      "get": {
        "summary": "List organization-scoped reconciliation attempts with statement and base exact string amounts"
      }
    },
    "/api/v1/organizations/{organizationId}/banking/reconciliations/{reconciliationId}": {
      "get": {
        "summary": "Read bank transaction to allocations payment journal source documents and authorized evidence drill-down"
      }
    },
    "/api/v1/organizations/{organizationId}/banking/transactions/{transactionId}/transfer-candidates": {
      "get": {
        "operationId": "listInternalTransferCandidates",
        "tags": ["internal-transfers"],
        "summary": "List explainable same-currency own-account transfer candidates without inferring fees or FX",
        "parameters": [
          { "$ref": "#/components/parameters/OrganizationId" },
          { "$ref": "#/components/parameters/TransactionId" }
        ],
        "responses": {
          "200": {
            "description": "Candidate decision",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InternalTransferCandidateEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/v1/organizations/{organizationId}/banking/internal-transfers": {
      "get": {
        "operationId": "listInternalTransfers",
        "tags": ["internal-transfers"],
        "summary": "List organization-scoped internal transfers and current immutable attempt state",
        "parameters": [{ "$ref": "#/components/parameters/OrganizationId" }],
        "responses": {
          "200": {
            "description": "Transfer list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InternalTransferListEnvelope" }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createInternalTransfer",
        "tags": ["internal-transfers"],
        "summary": "Create an idempotent one-sided or complete own-account transfer with explicit principal transit and fee policy",
        "parameters": [
          { "$ref": "#/components/parameters/OrganizationId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateInternalTransferRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Transfer created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InternalTransferMutationEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/v1/organizations/{organizationId}/banking/internal-transfers/{transferId}": {
      "get": {
        "operationId": "getInternalTransfer",
        "tags": ["internal-transfers"],
        "summary": "Read transfer attempts legs transit balance journals reversals and next actions",
        "parameters": [
          { "$ref": "#/components/parameters/OrganizationId" },
          { "$ref": "#/components/parameters/TransferId" }
        ],
        "responses": {
          "200": {
            "description": "Transfer detail",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InternalTransferEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/v1/organizations/{organizationId}/banking/internal-transfers/{transferId}/match": {
      "post": {
        "operationId": "matchInternalTransfer",
        "tags": ["internal-transfers"],
        "summary": "Idempotently match the opposite own-account leg using deterministic locks and exact principal",
        "parameters": [
          { "$ref": "#/components/parameters/OrganizationId" },
          { "$ref": "#/components/parameters/TransferId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MatchInternalTransferRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Transfer matched",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InternalTransferMutationEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/v1/organizations/{organizationId}/banking/internal-transfers/{transferId}/unmatch": {
      "post": {
        "operationId": "unmatchInternalTransfer",
        "tags": ["internal-transfers"],
        "summary": "Privileged reasoned unmatch using immutable reversal journals",
        "parameters": [
          { "$ref": "#/components/parameters/OrganizationId" },
          { "$ref": "#/components/parameters/TransferId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UnmatchInternalTransferRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Transfer unmatched",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InternalTransferMutationEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "operationId": "getOpenApiContract",
        "tags": ["discovery"],
        "summary": "Read the canonical versioned machine-readable API contract",
        "security": []
      }
    },
    "/api/v1/capabilities": {
      "get": {
        "operationId": "listApiCapabilities",
        "tags": ["discovery"],
        "summary": "Read a compact operation and resource index derived from the canonical OpenAPI contract",
        "security": []
      }
    },
    "/api/v1/organizations/{organizationId}/outbound-events/endpoints": {
      "get": {
        "summary": "List organization-scoped outbound endpoint metadata without returning secrets"
      },
      "post": {
        "summary": "Create an idempotent HTTPS outbound endpoint configuration using a runtime secret reference"
      }
    },
    "/api/v1/organizations/{organizationId}/outbound-events/endpoints/{endpointId}": {
      "get": {
        "summary": "Read one outbound endpoint and its subscribed event types and operational status"
      },
      "patch": {
        "summary": "Update endpoint subscriptions retry policy or status with optimistic version and idempotency"
      }
    },
    "/api/v1/organizations/{organizationId}/outbound-events/outbox": {
      "get": {
        "summary": "List immutable schema-versioned outbox events and dead-letter state"
      }
    },
    "/api/v1/organizations/{organizationId}/outbound-events/outbox/{eventId}": {
      "get": {
        "summary": "Read one outbox event with redacted delivery summary and aggregate correlation"
      }
    },
    "/api/v1/organizations/{organizationId}/outbound-events/outbox/{eventId}/replay": {
      "post": {
        "summary": "Idempotently replay a dead-letter outbound event with privileged reason and append-only audit"
      }
    },
    "/api/v1/organizations/{organizationId}/outbound-events/deliveries": {
      "get": {
        "summary": "List outbound delivery attempts with retry state and redacted HTTP results"
      }
    },
    "/api/v1/organizations/{organizationId}/outbound-events/deliveries/{deliveryId}": {
      "get": {
        "summary": "Read one append-only delivery attempt without exposing endpoint credentials"
      }
    }
  },
  "components": {
    "parameters": {
      "OrganizationId": {
        "name": "organizationId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "TransactionId": {
        "name": "transactionId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "TransferId": {
        "name": "transferId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "minLength": 1 }
      }
    },
    "schemas": {
      "ExactMinorAmount": { "type": "string", "pattern": "^[0-9]+$" },
      "TransferFee": {
        "type": "object",
        "required": ["mode", "amountMinor", "baseAmountMinor", "expenseAccountId", "reason"],
        "properties": {
          "mode": { "type": "string", "enum": ["embedded", "separate_transaction"] },
          "amountMinor": { "$ref": "#/components/schemas/ExactMinorAmount" },
          "baseAmountMinor": { "$ref": "#/components/schemas/ExactMinorAmount" },
          "expenseAccountId": { "type": "string" },
          "reason": { "type": "string" },
          "transactionId": { "type": "string" },
          "journalId": { "type": "string" }
        }
      },
      "TransferLeg": {
        "type": "object",
        "required": [
          "role",
          "transactionId",
          "financialAccountId",
          "ledgerAccountId",
          "statementAmountMinor",
          "principalAmountMinor",
          "baseAmountMinor",
          "currency",
          "bookingDate"
        ],
        "properties": {
          "role": { "type": "string", "enum": ["source", "destination"] },
          "transactionId": { "type": "string" },
          "financialAccountId": { "type": "string" },
          "ledgerAccountId": { "type": "string" },
          "statementAmountMinor": { "type": "string" },
          "principalAmountMinor": { "$ref": "#/components/schemas/ExactMinorAmount" },
          "baseAmountMinor": { "$ref": "#/components/schemas/ExactMinorAmount" },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "bookingDate": { "type": "string", "format": "date" },
          "journalId": { "type": "string" }
        }
      },
      "InternalTransferAttempt": {
        "type": "object",
        "required": [
          "attemptNumber",
          "state",
          "postingMode",
          "transitAccountId",
          "journalIds",
          "reversalJournalIds"
        ],
        "properties": {
          "attemptNumber": { "type": "integer", "minimum": 1 },
          "state": {
            "type": "string",
            "enum": ["pending_counterpart", "matched", "reconciled", "unmatched", "needs_review"]
          },
          "postingMode": { "type": "string", "enum": ["direct", "transit"] },
          "transitAccountId": { "type": "string" },
          "source": { "$ref": "#/components/schemas/TransferLeg" },
          "destination": { "$ref": "#/components/schemas/TransferLeg" },
          "fee": { "$ref": "#/components/schemas/TransferFee" },
          "journalIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "reversalJournalIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string" }
          }
        }
      },
      "InternalTransfer": {
        "type": "object",
        "required": [
          "id",
          "principalAmountMinor",
          "basePrincipalAmountMinor",
          "currency",
          "state",
          "currentAttemptNumber",
          "attempts",
          "transitOutstandingMinor",
          "resourceVersion",
          "nextActions"
        ],
        "properties": {
          "id": { "type": "string" },
          "principalAmountMinor": { "$ref": "#/components/schemas/ExactMinorAmount" },
          "basePrincipalAmountMinor": { "$ref": "#/components/schemas/ExactMinorAmount" },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "state": {
            "type": "string",
            "enum": ["pending_counterpart", "matched", "reconciled", "unmatched", "needs_review"]
          },
          "currentAttemptNumber": { "type": "integer", "minimum": 1 },
          "attempts": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/InternalTransferAttempt" }
          },
          "transitOutstandingMinor": { "type": "string" },
          "resourceVersion": { "type": "string", "pattern": "^[0-9]+$" },
          "nextActions": { "type": "array", "items": { "type": "string" } }
        }
      },
      "CreateInternalTransferRequest": {
        "type": "object",
        "required": [
          "schemaVersion",
          "principalAmountMinor",
          "basePrincipalAmountMinor",
          "currency",
          "transitAccountId",
          "reason"
        ],
        "properties": {
          "schemaVersion": { "type": "integer", "enum": [1] },
          "id": { "type": "string" },
          "sourceTransactionId": { "type": "string" },
          "destinationTransactionId": { "type": "string" },
          "principalAmountMinor": { "$ref": "#/components/schemas/ExactMinorAmount" },
          "basePrincipalAmountMinor": { "$ref": "#/components/schemas/ExactMinorAmount" },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "transitAccountId": { "type": "string" },
          "postingMode": { "type": "string", "enum": ["direct", "transit"] },
          "fee": { "$ref": "#/components/schemas/TransferFee" },
          "reason": { "type": "string", "minLength": 1 }
        },
        "anyOf": [
          { "required": ["sourceTransactionId"] },
          { "required": ["destinationTransactionId"] }
        ]
      },
      "MatchInternalTransferRequest": {
        "type": "object",
        "required": [
          "schemaVersion",
          "counterpartTransactionId",
          "expectedResourceVersion",
          "reason"
        ],
        "properties": {
          "schemaVersion": { "type": "integer", "enum": [1] },
          "counterpartTransactionId": { "type": "string" },
          "expectedResourceVersion": { "type": "string", "pattern": "^[0-9]+$" },
          "reason": { "type": "string", "minLength": 1 }
        }
      },
      "UnmatchInternalTransferRequest": {
        "type": "object",
        "required": ["schemaVersion", "expectedResourceVersion", "reason"],
        "properties": {
          "schemaVersion": { "type": "integer", "enum": [1] },
          "expectedResourceVersion": { "type": "string", "pattern": "^[0-9]+$" },
          "reason": { "type": "string", "minLength": 1 }
        }
      },
      "TransferCandidate": {
        "type": "object",
        "required": [
          "transactionId",
          "financialAccountId",
          "bookingDate",
          "currency",
          "amountMinor",
          "eligible",
          "confidenceBps",
          "factors",
          "reasons"
        ],
        "properties": {
          "transactionId": { "type": "string" },
          "financialAccountId": { "type": "string" },
          "bookingDate": { "type": "string", "format": "date" },
          "currency": { "type": "string" },
          "amountMinor": { "type": "string" },
          "eligible": { "type": "boolean" },
          "confidenceBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
          "factors": { "type": "object", "additionalProperties": { "type": "integer" } },
          "reasons": { "type": "array", "items": { "type": "string" } }
        }
      },
      "InternalTransferCandidateEnvelope": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "required": ["transactionId", "policyVersion", "thresholdBps", "outcome", "items"],
            "properties": {
              "transactionId": { "type": "string" },
              "policyVersion": { "type": "integer" },
              "thresholdBps": { "type": "integer" },
              "outcome": { "type": "string", "enum": ["unique", "ambiguous", "none"] },
              "selectedTransactionId": { "type": "string" },
              "items": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/TransferCandidate" }
              }
            }
          }
        }
      },
      "InternalTransferEnvelope": {
        "type": "object",
        "properties": { "data": { "$ref": "#/components/schemas/InternalTransfer" } }
      },
      "InternalTransferListEnvelope": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/InternalTransfer" }
              }
            }
          }
        }
      },
      "InternalTransferMutationEnvelope": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "transfer": { "$ref": "#/components/schemas/InternalTransfer" },
              "mutation": { "type": "object" }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]

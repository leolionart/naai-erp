{
  "schemaVersion": 1,
  "apiVersion": "v1",
  "scope": "organization",
  "authorityOrder": [
    "business-rules",
    "accepted-adrs",
    "openapi-runtime",
    "relationship-manifest",
    "examples-evidence"
  ],
  "universalMutationPolicy": {
    "transport": "REST application services or first-party CLI only",
    "requiredHeaders": ["Authorization", "Idempotency-Key", "X-Correlation-Id"],
    "versionHeader": "If-Match for versioned updates",
    "moneyEncoding": "integer minor units encoded as decimal strings",
    "directDatabaseAccess": false,
    "onMissingReference": "reject_or_review_never_guess"
  },
  "stages": [
    { "rank": 10, "id": "tenant_access" },
    { "rank": 20, "id": "fiscal_currency" },
    { "rank": 30, "id": "accounting_master" },
    { "rank": 40, "id": "parties_projects" },
    { "rank": 50, "id": "financial_accounts" },
    { "rank": 60, "id": "business_sources" },
    { "rank": 70, "id": "approval_posting" },
    { "rank": 80, "id": "banking_reconciliation" },
    { "rank": 90, "id": "project_cost_recognition" },
    { "rank": 100, "id": "planning_reporting" }
  ],
  "resources": [
    {
      "id": "organization",
      "stage": "tenant_access",
      "endpoint": "/master-data/organizations",
      "cli": "organizations",
      "identifiers": ["id"],
      "businessKeys": ["slug"],
      "dependsOn": [],
      "lifecycle": ["active", "inactive"],
      "correction": "deactivate"
    },
    {
      "id": "fiscal_year",
      "stage": "fiscal_currency",
      "endpoint": "/master-data/fiscal-years",
      "cli": "fiscal-years",
      "identifiers": ["organization_id", "id"],
      "businessKeys": ["label"],
      "dependsOn": ["organization"],
      "references": [
        {
          "field": "organization_id",
          "target": "organization",
          "targetKey": "id",
          "required": true,
          "onMissing": "reject"
        }
      ],
      "correction": "version_or_update_before_lock"
    },
    {
      "id": "fiscal_period",
      "stage": "fiscal_currency",
      "endpoint": "/master-data/fiscal-periods",
      "cli": "fiscal-periods",
      "identifiers": ["organization_id", "id"],
      "dependsOn": ["fiscal_year"],
      "references": [
        {
          "field": "fiscal_year_id",
          "target": "fiscal_year",
          "targetKey": "id",
          "required": true,
          "onMissing": "reject"
        }
      ],
      "lifecycle": ["open", "soft_locked", "hard_locked"],
      "correction": "reopen_with_reason"
    },
    {
      "id": "account",
      "stage": "accounting_master",
      "endpoint": "/master-data/accounts",
      "cli": "accounts",
      "identifiers": ["organization_id", "code"],
      "businessKeys": ["code"],
      "dependsOn": ["organization"],
      "lifecycle": ["active", "inactive"],
      "correction": "deactivate_never_delete_with_history"
    },
    {
      "id": "tax_code_version",
      "stage": "accounting_master",
      "endpoint": "/master-data/tax-code-versions",
      "cli": "tax-code-versions",
      "identifiers": ["organization_id", "code", "effective_from"],
      "dependsOn": ["organization"],
      "correction": "new_effective_version"
    },
    {
      "id": "dimension_value",
      "stage": "accounting_master",
      "endpoint": "/master-data/dimensions",
      "cli": "dimensions",
      "identifiers": ["organization_id", "kind", "code"],
      "dependsOn": ["organization"],
      "correction": "deactivate",
      "notes": "Transactional dimensions are a kind-to-code map validated by the application."
    },
    {
      "id": "default_mapping",
      "stage": "accounting_master",
      "endpoint": "/master-data/default-mappings",
      "cli": "default-mappings",
      "identifiers": ["organization_id", "document_type", "effective_from"],
      "dependsOn": ["account", "tax_code_version", "dimension_value"],
      "references": [
        {
          "field": "account_code",
          "target": "account",
          "targetKey": "code",
          "required": true,
          "onMissing": "reject"
        },
        {
          "field": "tax_code+tax_effective_from",
          "target": "tax_code_version",
          "targetKey": "code+effective_from",
          "required": false,
          "onMissing": "reject"
        }
      ],
      "correction": "new_effective_version"
    },
    {
      "id": "party",
      "stage": "parties_projects",
      "endpoint": "/master-data/parties",
      "cli": "parties",
      "identifiers": ["id"],
      "businessKeys": ["normalized_tax_id", "display_name"],
      "externalIdentity": "organization+external_system+external_id where supplied",
      "dependsOn": ["organization"],
      "lifecycle": ["active", "inactive", "merged"],
      "correction": "update_draft_or_merge_preserving_history"
    },
    {
      "id": "party_role",
      "stage": "parties_projects",
      "endpoint": "/master-data/party-roles",
      "cli": "party-roles",
      "identifiers": ["party_id", "role"],
      "dependsOn": ["party"],
      "references": [
        {
          "field": "party_id",
          "target": "party",
          "targetKey": "id",
          "required": true,
          "onMissing": "reject"
        }
      ],
      "correction": "deactivate"
    },
    {
      "id": "project",
      "stage": "parties_projects",
      "endpoint": "/master-data/projects",
      "cli": "projects",
      "identifiers": ["id"],
      "businessKeys": ["code"],
      "dependsOn": ["party", "party_role"],
      "references": [
        {
          "field": "client_party_id",
          "target": "party",
          "targetKey": "id",
          "required": true,
          "onMissing": "reject"
        }
      ],
      "lifecycle": ["planned", "active", "on_hold", "completed", "closed"],
      "correction": "update_before_close_or_approved_reopen"
    },
    {
      "id": "service_plan",
      "stage": "parties_projects",
      "endpoint": "/service-plans",
      "cli": "service-plans",
      "identifiers": ["id"],
      "businessKeys": ["code"],
      "dependsOn": ["dimension_value"],
      "references": [
        {
          "field": "serviceLineCode",
          "target": "dimension_value",
          "targetKey": "kind=service_line+code",
          "required": true,
          "onMissing": "reject"
        }
      ],
      "lifecycle": ["active", "inactive"],
      "correction": "update_while_active_or_deactivate_preserving_history"
    },
    {
      "id": "contract",
      "stage": "parties_projects",
      "endpoint": "/master-data/contracts",
      "cli": "contracts",
      "identifiers": ["id"],
      "dependsOn": ["project"],
      "references": [
        {
          "field": "project_id",
          "target": "project",
          "targetKey": "id",
          "required": true,
          "onMissing": "reject"
        }
      ],
      "correction": "update_versioned_terms"
    },
    {
      "id": "milestone",
      "stage": "parties_projects",
      "endpoint": "/master-data/milestones",
      "cli": "milestones",
      "identifiers": ["id"],
      "dependsOn": ["contract"],
      "references": [
        {
          "field": "contract_id",
          "target": "contract",
          "targetKey": "id",
          "required": true,
          "onMissing": "reject"
        }
      ],
      "correction": "update_before_acceptance"
    },
    {
      "id": "financial_account",
      "stage": "financial_accounts",
      "endpoint": "/banking/accounts",
      "cli": "bank-accounts",
      "identifiers": ["accountId"],
      "businessKeys": ["code"],
      "dependsOn": ["account"],
      "references": [
        {
          "field": "ledgerAccountCode",
          "target": "account",
          "targetKey": "code",
          "required": true,
          "onMissing": "reject"
        }
      ],
      "correction": "deactivate; PATCH is a known unavailable runtime gap"
    },
    {
      "id": "customer_service_subscription",
      "stage": "business_sources",
      "endpoint": "/customer-service-subscriptions",
      "cli": "customer-service-subscriptions",
      "identifiers": ["id"],
      "dependsOn": ["party", "party_role", "service_plan", "project"],
      "references": [
        {
          "field": "customerPartyId",
          "target": "party",
          "targetKey": "id",
          "required": true,
          "onMissing": "reject"
        },
        {
          "field": "customerPartyId+client",
          "target": "party_role",
          "targetKey": "party_id+role",
          "required": true,
          "onMissing": "reject"
        },
        {
          "field": "servicePlanId",
          "target": "service_plan",
          "targetKey": "id",
          "required": true,
          "onMissing": "reject"
        },
        {
          "field": "projectId",
          "target": "project",
          "targetKey": "id",
          "required": false,
          "onMissing": "reject"
        }
      ],
      "relationshipAssertions": [
        "party has client role",
        "service plan is active before activation",
        "when projectId is present project.client_party_id equals customerPartyId"
      ],
      "lifecycle": ["draft", "active", "paused", "cancelled", "expired"],
      "correction": "patch_draft_or_typed_lifecycle_action",
      "accountingBoundary": "schedule preview is commercial only; invoices revenue and journals require separate canonical workflows"
    },
    {
      "id": "commercial_document",
      "stage": "business_sources",
      "endpoint": "/commercial-documents",
      "cli": "commercial-documents",
      "identifiers": ["documentId"],
      "businessKeys": ["type", "series", "fiscalYear", "documentNumber"],
      "externalIdentity": "externalReference.system+externalReference.externalId",
      "dependsOn": [
        "party",
        "project",
        "contract",
        "account",
        "tax_code_version",
        "dimension_value"
      ],
      "references": [
        {
          "field": "partyId",
          "target": "party",
          "targetKey": "id",
          "required": true,
          "onMissing": "reject"
        },
        {
          "field": "lines[].primaryAccountCode",
          "target": "account",
          "targetKey": "code",
          "required": true,
          "onMissing": "reject"
        },
        {
          "field": "lines[].taxAccountCode",
          "target": "account",
          "targetKey": "code",
          "required": false,
          "onMissing": "reject"
        },
        {
          "field": "lines[].dimensions[kind]",
          "target": "dimension_value",
          "targetKey": "kind+code",
          "required": false,
          "onMissing": "reject"
        },
        {
          "field": "lines[].dimensions.projectId|lines[].allocations[].dimensions.projectId",
          "target": "project",
          "targetKey": "id",
          "required": false,
          "onMissing": "reject"
        },
        {
          "field": "lines[].dimensions.contractId|lines[].allocations[].dimensions.contractId",
          "target": "contract",
          "targetKey": "id",
          "required": false,
          "onMissing": "reject"
        },
        {
          "field": "originalDocumentId",
          "target": "commercial_document",
          "targetKey": "documentId",
          "required": false,
          "onMissing": "reject"
        }
      ],
      "lifecycle": [
        "draft",
        "captured",
        "verified",
        "approved",
        "validated",
        "issued",
        "posted",
        "partially_paid",
        "paid",
        "cancelled"
      ],
      "responseIds": ["data.documentId", "data.journalId"],
      "listRelationshipFields": ["projectIds", "contractIds"],
      "relationshipRules": [
        "sales_invoice and credit_note: partyId must equal every allocated project's client_party_id",
        "sales_invoice: every allocation must include dimensions.projectId before issue",
        "contractId requires projectId and contract.project_id must equal the selected projectId",
        "allocation relationship dimensions inherit matching line relationship dimensions when omitted",
        "sales_invoice: issue is rejected when the project has no signed contract capacity as of documentDate or when cumulative issued net allocations exceed signed contract plus approved scope-change capacity",
        "sales_invoice: current capacity enforcement remains aggregate by project; an explicit contractId is retained but does not imply per-contract cap consumption; milestoneId is not persisted and must not be inferred",
        "purchase_invoice: partyId is the supplier; allocated project.client_party_id is the end client and is not expected to equal the supplier",
        "credit_note: partyId must equal originalDocumentId.partyId and project allocations must remain within the eligible original allocation scope"
      ],
      "relationshipBackfill": {
        "inventory": "GET /commercial-documents/relationship-backfill/inventory",
        "dryRun": "POST /commercial-documents/{documentId}/relationship-backfill/dry-run",
        "commit": "POST /commercial-documents/{documentId}/relationship-backfill/commit",
        "eligibleStates": ["issued", "posted", "partially_paid", "paid"],
        "requiredDryRunInputs": ["If-Match", "replacement", "reason"],
        "requiredCommitInputs": [
          "If-Match",
          "Idempotency-Key",
          "replacement",
          "reason",
          "planHash"
        ],
        "effects": ["reverse_original_journal", "cancel_original", "create_replacement_draft"],
        "planHash": "sha256(normalized {id, expectedVersion, replacement, trimmed reason})",
        "correctionResult": "original cancelled; replacement draft; external identity transferred"
      },
      "correction": "PATCH draft; cancel before issue; credit or reverse/replace after issue/post"
    },
    {
      "id": "quick_purchase_invoice_ingestion",
      "stage": "business_sources",
      "endpoint": "/commercial-documents/purchase-invoice-ingestion",
      "method": "POST",
      "cli": "quick-purchase-invoices create",
      "scope": "organization",
      "identifiers": ["supplierTaxId", "externalReference.system+externalReference.externalId"],
      "dependsOn": ["organization", "account"],
      "requiredHeaders": ["Authorization", "Idempotency-Key", "X-Correlation-Id"],
      "relationshipSequence": [
        "normalize supplierTaxId",
        "resolve exact or uniquely similar active expense category",
        "resolve or create same-organization party",
        "ensure explicit supplier party role",
        "resolve active category account mappings",
        "create canonical purchase_invoice"
      ],
      "inputRelationshipFields": [
        "supplierTaxId",
        "category",
        "externalReference.system",
        "externalReference.externalId"
      ],
      "responseIds": [
        "data.supplier.partyId",
        "data.category.code",
        "data.document.documentId",
        "data.document.journalId",
        "resourceVersion",
        "auditEventId"
      ],
      "idempotency": {
        "required": true,
        "sameKeySamePayload": "replay_same_business_effect",
        "sameKeyChangedPayload": "conflict"
      },
      "defaultsAndBoundaries": [
        "currency defaults to VND",
        "dueDate defaults to documentDate",
        "gross is recorded as management cost with zero VAT until real VAT evidence is supplied",
        "tax eligibility remains unreviewed",
        "never create a duplicate Expense",
        "never infer projectId contractId payment account VAT eligibility or tax eligibility"
      ],
      "lifecycle": "follow response nextActions; solopreneur owner policy may atomically return posted or paid while controlled mode may return draft",
      "correction": "DELETE only while draft with If-Match and Idempotency-Key; otherwise cancel credit reverse or replace"
    },
    {
      "id": "expense",
      "stage": "business_sources",
      "endpoint": "/expenses",
      "cli": "expenses",
      "identifiers": ["expenseId"],
      "externalIdentity": "externalReference.system+externalReference.externalId",
      "dependsOn": [
        "party",
        "project",
        "contract",
        "account",
        "tax_code_version",
        "dimension_value"
      ],
      "references": [
        {
          "field": "payeePartyId",
          "target": "party",
          "targetKey": "id",
          "required": false,
          "onMissing": "review"
        },
        {
          "field": "employeePartyId",
          "target": "party",
          "targetKey": "id",
          "required": false,
          "onMissing": "reject_for_employee_reimbursement"
        },
        {
          "field": "counterAccountCode",
          "target": "account",
          "targetKey": "code",
          "required": true,
          "onMissing": "reject"
        },
        {
          "field": "lines[].postingAccountCode",
          "target": "account",
          "targetKey": "code",
          "required": true,
          "onMissing": "reject"
        },
        {
          "field": "lines[].dimensions[kind]",
          "target": "dimension_value",
          "targetKey": "kind+code",
          "required": false,
          "onMissing": "reject"
        },
        {
          "field": "lines[].dimensions.projectId|lines[].allocations[].dimensions.projectId",
          "target": "project",
          "targetKey": "id",
          "required": false,
          "onMissing": "reject"
        },
        {
          "field": "lines[].dimensions.contractId|lines[].allocations[].dimensions.contractId",
          "target": "contract",
          "targetKey": "id",
          "required": false,
          "onMissing": "reject"
        }
      ],
      "lifecycle": ["draft", "submitted", "evidence_pending", "approved", "rejected", "posted"],
      "responseIds": ["data.expenseId", "data.journalId"],
      "listRelationshipFields": ["projectIds", "contractIds"],
      "relationshipRules": [
        "payeePartyId is the supplier/payee and is independent from the receiving project's client_party_id",
        "contractId requires projectId and contract.project_id must equal the selected projectId",
        "allocation relationship dimensions inherit matching line relationship dimensions when omitted",
        "PATCH without lines preserves stored lines and allocations; sending lines explicitly replaces them"
      ],
      "relationshipBackfill": {
        "inventory": "GET /expenses/relationship-backfill/inventory",
        "dryRun": "POST /expenses/{expenseId}/relationship-backfill/dry-run",
        "commit": "POST /expenses/{expenseId}/relationship-backfill/commit",
        "eligibleStates": ["posted"],
        "requiredDryRunInputs": ["If-Match", "replacement", "reason"],
        "requiredCommitInputs": [
          "If-Match",
          "Idempotency-Key",
          "replacement",
          "reason",
          "planHash"
        ],
        "effects": ["reverse_original_journal", "reverse_original", "create_replacement_draft"],
        "planHash": "sha256(normalized {id, expectedVersion, replacement, trimmed reason})",
        "correctionResult": "original reversed; replacement draft; external identity transferred"
      },
      "correction": "PATCH draft; reverse/replace posted; invoice-backed spend must use purchase invoice"
    },
    {
      "id": "evidence",
      "stage": "business_sources",
      "endpoint": "/evidence",
      "cli": "evidence",
      "identifiers": ["evidenceId"],
      "dependsOn": ["commercial_document", "expense"],

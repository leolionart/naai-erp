  },
  "devDependencies": {
    "@types/pg": "8.20.4",
    "drizzle-kit": "0.31.10",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pg": "8.22.0"
  }
}
